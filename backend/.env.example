# Database Configuration (PostgreSQL on Neon or Local)
# Format: postgresql://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_buddy

# Security & Authentication (Generate with: openssl rand -hex 32)
SECRET_KEY=change-this-to-a-super-secret-key-in-production

# Google Gemini API Key & Model (Meeting Intelligence & Summarization - Free Tier)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# Frontend Application URL for CORS (e.g., https://your-app.vercel.app or http://localhost:5173)
# Multiple origins can be comma-separated: https://app1.vercel.app,https://app2.vercel.app
FRONTEND_URL=http://localhost:5173

# Demo Mode Feature Switches (Set to 'false' for 512MB RAM free-tier cloud deployments)
# ENABLE_PROCESSING: When false, uploads/Whisper/FFmpeg are disabled (returns friendly 503)
ENABLE_PROCESSING=true

# ENABLE_EMBEDDINGS: When false, FastEmbed is not loaded and search/chat fall back to keyword matching
ENABLE_EMBEDDINGS=true

# Semantic Indexing & FastEmbed Model (Free, local ONNX embeddings - used when ENABLE_EMBEDDINGS=true)
# English default (384-dim, ~67MB): BAAI/bge-small-en-v1.5
# Hindi/Marathi multilingual (384-dim, ~470MB): sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
