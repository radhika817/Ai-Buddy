# Database Configuration (PostgreSQL)
# Format: postgresql://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_buddy

# Security & Authentication (Generate with: openssl rand -hex 32)
SECRET_KEY=change-this-to-a-super-secret-key-in-production

# Google Gemini API Key & Model (Meeting Intelligence & Summarization)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# Frontend Application URL for CORS (e.g., https://your-app.vercel.app or http://localhost:5173)
# Multiple origins can be comma-separated: https://app1.vercel.app,https://app2.vercel.app
FRONTEND_URL=http://localhost:5173

# Semantic Indexing & FastEmbed Model (Free, local ONNX embeddings - no API key needed)
# English default (384-dim, ~67MB): BAAI/bge-small-en-v1.5
# Hindi/Marathi multilingual (384-dim, ~470MB): sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
